[Unit]
Description=LSP Global staging Next.js
After=network.target php8.5-fpm.service mariadb.service

[Service]
Type=simple
User=deploy
Group=www-data
WorkingDirectory=/var/www/lsp-global/frontend
Environment=NODE_ENV=production
ExecStart=/usr/bin/npm run start -- --hostname 127.0.0.1 --port 3000
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
UMask=0027

[Install]
WantedBy=multi-user.target
