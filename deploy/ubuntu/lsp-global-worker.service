[Unit]
Description=LSP Global staging queue worker
After=network.target mariadb.service

[Service]
Type=simple
User=deploy
Group=www-data
WorkingDirectory=/var/www/lsp-global/backend
ExecStart=/usr/bin/php8.5 artisan queue:work --sleep=3 --tries=3 --timeout=60 --max-time=3600
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=90
NoNewPrivileges=true
PrivateTmp=true
UMask=0007

[Install]
WantedBy=multi-user.target
