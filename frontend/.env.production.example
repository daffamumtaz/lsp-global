# Vercel: set Root Directory to frontend, then copy these keys into project
# Environment Variables for Production (and Preview with its own backend).
# Replace backend.example.com and project-ref with your actual deployment.
LANDING_API_URL=https://backend.example.com/api/landing-page
PROFILE_API_URL=https://backend.example.com/api/profile-page
ORGANIZATION_API_URL=https://backend.example.com/api/organization
CONTENT_API_URL=https://backend.example.com/api/content-directory
INFORMATION_API_URL=https://backend.example.com/api/information-page
PROCESSES_API_URL=https://backend.example.com/api/processes
ADMIN_PREVIEW_ORIGIN=https://backend.example.com
LANDING_MEDIA_ORIGIN=https://project-ref.supabase.co

NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION='&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
