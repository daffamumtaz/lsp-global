APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=
# DB_PORT=5432
# DB_DATABASE=postgres
# DB_USERNAME=
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

FRONTEND_URL=http://localhost:3000

# Render: configure these through its environment settings; keep APP_KEY stable.
TRUSTED_PROXIES=
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
# PostgreSQL: set DB_CONNECTION=pgsql and populate the DB_* fields above.
# Use Supabase session pooler connection details copied from its Connect dialog.
DB_URL=
DB_SSLMODE=require

# public stays local by default; set supabase to use a PUBLIC Supabase bucket.
PUBLIC_FILESYSTEM_DRIVER=local
# Supabase Free defaults to 50 MB; match the remote bucket's actual limit.
MEDIA_MAX_UPLOAD_KB=51200
# Docker startup only; migrations are enabled in the Render Blueprint.
RUN_MIGRATIONS=false
# MFA is required by default in production; set an override deliberately.
# ADMIN_MFA_REQUIRED=true
PUBLIC_CONTENT_REQUESTS_PER_MINUTE=600
CONTENT_DIRECTORY_CACHE_SECONDS=30
# AWS credentials above must be S3 credentials, not publishable/service-role keys.
AWS_ENDPOINT=
# Public read URL: https://<project-ref>.supabase.co/storage/v1/object/public/<bucket>
AWS_URL=
# Optional override for assets bundled into Docker at /app/resources/frontend-public.
# FRONTEND_ASSETS_PATH=
