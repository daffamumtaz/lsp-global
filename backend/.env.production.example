# Render: backend/render.yaml deploys only the backend; root render.yaml also
# offers a frontend on Render. Both Docker builds use the repository root.
# Fill these values in Render's Environment settings, never in a committed .env.
APP_NAME="LSP TIK Global"
APP_ENV=production
APP_DEBUG=false
# Generate once with php artisan key:generate --show; retain it across deploys.
APP_KEY=
APP_URL=https://backend.example.com
FRONTEND_URL=https://frontend.example.com
TRUSTED_PROXIES=*
RUN_MIGRATIONS=true
ADMIN_MFA_REQUIRED=true
PUBLIC_CONTENT_REQUESTS_PER_MINUTE=600
CONTENT_DIRECTORY_CACHE_SECONDS=30

# Copy Session pooler values from Supabase Connect; use port 5432, not 6543.
# Laravel migrations own the schema. Run PHP migrations, not supabase db push.
# Disable the remote Data API before first migration if only Laravel uses DB.
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=sync
LOG_CHANNEL=stderr
LOG_LEVEL=warning

FILESYSTEM_DISK=local
PUBLIC_FILESYSTEM_DRIVER=supabase
MEDIA_MAX_UPLOAD_KB=51200
# Create a PUBLIC website-media bucket and S3 access credentials in Supabase.
# These are S3 keys, not anon, publishable, or service-role API keys.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=website-media
AWS_ENDPOINT=https://project-ref.supabase.co/storage/v1/s3
AWS_URL=https://project-ref.supabase.co/storage/v1/object/public/website-media

# First empty deployment: php artisan deployment:prepare --import-content
# Retry only missing frontend assets: php artisan deployment:prepare --import-assets
# Existing media: run locally with Supabase env configured, first --dry-run:
# php artisan media:sync-to-supabase --dry-run
# Create an admin: php artisan make:filament-user, then admin:grant <email>.
MAIL_MAILER=log
