APP_NAME="LSP TIK Global"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://backend.example.com
FRONTEND_URL=https://frontend.example.com
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
DB_CONNECTION=mariadb
DB_URL=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lsp_global_production
DB_USERNAME=lsp_production
DB_PASSWORD=
DB_SOCKET=
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_COOKIE=lsp_global_production_session
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=null
FILESYSTEM_DISK=local
MEDIA_MAX_UPLOAD_KB=102400
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=lsp_production
BROADCAST_CONNECTION=log
MAIL_MAILER=log
MAIL_FROM_ADDRESS=website@example.com
MAIL_FROM_NAME="${APP_NAME}"
TRUSTED_PROXIES=127.0.0.1
ADMIN_MFA_REQUIRED=true
PUBLIC_CONTENT_REQUESTS_PER_MINUTE=600
CONTENT_DIRECTORY_CACHE_SECONDS=30
VITE_APP_NAME="${APP_NAME}"
